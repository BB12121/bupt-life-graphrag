# Copy to .env (git-ignored; loaded automatically, existing environment variables win).
BUPT_DATA_DIR=data
# Built Vue application directory, resolved automatically when omitted.
# BUPT_FRONTEND_DIST=bupt-graphrag-frontend/dist
BUPT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Commit-pinned model; change this to explicitly rebuild embeddings on next sync.
BUPT_EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
BUPT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional, required as X-Admin-Key for sync if set. Bind locally by default.
BUPT_ADMIN_KEY=
# Optional local OpenAI-compatible llama.cpp server; generation is not needed for answers.
BUPT_LLM_BASE_URL=
BUPT_LLM_MODEL=qwen3.8-27b
# Remote OpenAI-compatible service: set its HTTPS base URL above.
# Never put this key in frontend VITE_* settings or commit it.
BUPT_LLM_API_KEY=
